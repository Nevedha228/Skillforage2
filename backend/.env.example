APP_ENV=development
APP_NAME=SkillForage AI
APP_URL=http://localhost:5173
SECRET_KEY=change_this_to_a_random_secret_token_hex_32
DATABASE_URL=sqlite:///./skillforage.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_EXPIRE_DAYS=7

# Email / OTP Settings (Pluggable: leave empty in development for secure console-mode OTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@skillforage.ai

# Optional External APIs (gracefully disabled when unset)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
LLM_API_KEY=
